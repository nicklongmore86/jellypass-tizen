{
  "name": "jellypass-tizen",
  "version": "0.2.0",
  "description": "Household-scoped JellyPass client for Samsung Smart TV (Tizen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicklongmore86/jellypass-tizen.git"
  },
  "scripts": {
    "build": "gulp && npm run configure",
    "configure": "node scripts/configure-jellypass.mjs",
    "build:full": "bash scripts/build.sh",
    "package:wgt": "bash scripts/package-wgt.sh",
    "postinstall": "npm run build",
    "test": "node --test --test-isolation=none test/*.test.mjs"
  },
  "devDependencies": {
    "@babel/preset-env": "7.25.7",
    "@babel/register": "7.25.7",
    "del": "8.0.0",
    "gulp": "5.0.0",
    "gulp-dom": "1.0.0",
    "gulp-if": "3.0.0",
    "gulp-scan": "0.1.4"
  },
  "type": "module"
}
